# Backend environment variables
# Copie este arquivo para .env e preencha os valores reais antes de subir o Docker.

# Supabase (PostgreSQL)
DB_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Tamanho máximo do pool de conexões (opcional, padrão 5)
DB_POOL_MAX_SIZE=5

# Porta do back-end (opcional, padrão 8080)
SERVER_PORT=8080

# Chave para cadastro de agentes (EMPRESA/BANCO)
# Defina uma string forte e compartilhe apenas com administradores.
AGENT_REGISTRATION_KEY=sua_chave_secreta_aqui

# Domínio para HTTPS remoto (opcional, padrão localhost)
DOMAIN=localhost
